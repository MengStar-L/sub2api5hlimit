# Copy to /opt/sub2api5hlimit/config/sub2api-limit-portal.env and keep mode 0640.
# Generate it with: /opt/sub2api5hlimit/bin/sub2api-limit-portal keygen

SUB2API_LIMIT_LISTEN=0.0.0.0:2556
SUB2API_LIMIT_DB_PATH=/opt/sub2api5hlimit/data/app.db
SUB2API_LIMIT_MASTER_KEY=

# Direct HTTP access requires false because browsers do not send Secure cookies
# over HTTP. Set true when every browser reaches the portal through HTTPS.
SUB2API_LIMIT_COOKIE_SECURE=false
